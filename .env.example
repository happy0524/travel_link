# Browser key: public, restrict to HTTP referrers and Maps JavaScript API + Places API (New)
GOOGLE_MAPS_BROWSER_KEY=
# Optional browser-safe Cloud Map ID; empty uses embedded green styling.
GOOGLE_MAPS_MAP_ID=
# Public Mapbox web token (pk.), visible to browser; restrict permitted URLs.
MAPBOX_PUBLIC_TOKEN=
# Server key: never sent to browser; restrict to server IP + Routes API + Time Zone API
GOOGLE_MAPS_SERVER_KEY=
PORT=5173

# Optional development request counters (disabled in NODE_ENV=production)
REQUEST_MONITOR=0

# Optional limits. Lower these if other apps share the billing account.
# GOOGLE_TIME_ZONE_MONTHLY_LIMIT=10010
# GOOGLE_ROUTES_ESSENTIALS_MONTHLY_LIMIT=10010
# GOOGLE_ROUTES_PRO_MONTHLY_LIMIT=5010
# GOOGLE_TIME_ZONE_FREE_ALLOCATION=10000
# GOOGLE_ROUTES_ESSENTIALS_FREE_ALLOCATION=10000
# GOOGLE_ROUTES_PRO_FREE_ALLOCATION=5000
# TRAVEL_LINK_OTHER_COST_RESERVE_KRW=50000
# TRAVEL_LINK_USD_KRW_ALL_IN=2000
# TRAVEL_LINK_BROWSER_MONTHLY_PERMITS=1000
# TRAVEL_LINK_API_IP_PER_MINUTE=120
# TRAVEL_LINK_API_USER_PER_MINUTE=90
# TRAVEL_LINK_API_TOTAL_PER_MINUTE=240
# TRAVEL_LINK_API_CONCURRENCY=8
# TRAVEL_LINK_API_PAUSED=0
# TRAVEL_LINK_MAPBOX_ENABLED=1
# TRAVEL_LINK_GOOGLE_WIDGETS=1
# TRAVEL_LINK_GOOGLE_MEDIA=1

